    "### 3. Busca aproximada"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "f545ed5b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Lista\n",
    "v = [9, 42, 21, 14, 25, 3, 19, 33, 45, 6]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "5e5c51f9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "O valor mais próximo de 31 é: 33\n"
     ]
    }
   ],
   "source": [
    "k = 31\n",
    "dist = abs(v[0] - k)\n",
    "min = v[0]\n",
    "\n",
    "for i in range(1, len(v), 1):\n",
    "    if abs(v[i] - k) < dist:\n",
    "        dist = abs(v[i] - k)\n",
    "        min = v[i]\n",
    "print(f\"O valor mais próximo de {k} é: {min}\")"
   ]
  }
